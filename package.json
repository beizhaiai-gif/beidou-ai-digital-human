{
  "name": "beizhai-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "icons": "python3 electron/icons/make_icons.py",
    "pack:mac": "npm run build && electron-builder --mac --x64",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:all": "npm run build && electron-builder --mac --win --x64"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "cn.beidou.digitalhuman",
    "productName": "北抖AI数字人",
    "directories": {
      "output": "release",
      "buildResources": "electron/icons"
    },
    "asar": false,
    "files": [
      "dist/**",
      "electron/main.js",
      "electron/preload.cjs",
      "server/**",
      "!server/jobs",
      "!server/data",
      "!server/config",
      "package.json"
    ],
    "extraResources": [],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "icon": "electron/icons/icon.icns",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "北抖AI数字人",
      "writeUpdateInfo": true
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
